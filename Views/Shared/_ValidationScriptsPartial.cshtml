@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // Newer Visual Studio templates put the unobtrusive script under dist/,
    // older ones do not. A wrong path fails silently — a 404 in the network
    // tab and no client-side validation at all — so use whichever file this
    // project actually has.
    const string withDist = "lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js";
    const string withoutDist = "lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js";

    var unobtrusive = Env.WebRootFileProvider.GetFileInfo(withDist).Exists ? withDist : withoutDist;
}
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="@Url.Content("~/" + unobtrusive)"></script>
<script src="~/js/validation-extras.js" asp-append-version="true"></script>
