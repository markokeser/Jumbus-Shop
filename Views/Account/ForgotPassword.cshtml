@model WebShop.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = L["Account_ForgotTitle"].Value;
    ViewData["NoIndex"] = true;
}

<div class="shell auth">
    <h1>@L["Account_ForgotTitle"]</h1>
    <p class="auth-lede">@L["Account_ForgotLede"]</p>

    <form method="post" asp-controller="Account" asp-action="ForgotPassword" class="auth-form">
        <div class="cinput">
            <label asp-for="Email">@L["Checkout_Email"]</label>
            <input asp-for="Email" type="email" autocomplete="email" autofocus />
            <span asp-validation-for="Email"></span>
        </div>

        <button type="submit" class="btn-shop auth-submit">@L["Account_SendLink"]</button>
    </form>

    <p class="auth-alt">
        <a asp-controller="Account" asp-action="Login">@L["Account_BackToSignIn"]</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
