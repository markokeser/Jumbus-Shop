@{
    ViewData["Title"] = L["Account_ForgotTitle"].Value;
    ViewData["NoIndex"] = true;
    var devLink = TempData["DevResetLink"] as string;
}

<div class="shell auth">
    <h1>@L["Account_CheckInbox"]</h1>
    <p class="auth-lede">@L["Account_ForgotSent"]</p>

    @* Only ever set in Development, while no real mail is sent. *@
    @if (!string.IsNullOrEmpty(devLink))
    {
        <div class="notice">
            <p>@L["Account_DevLinkNote"]</p>
            <p><a href="@devLink">@devLink</a></p>
        </div>
    }

    <p class="auth-alt">
        <a asp-controller="Account" asp-action="Login">@L["Account_BackToSignIn"]</a>
    </p>
</div>
