@model WebShop.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = L["Account_ResetTitle"].Value;
    ViewData["NoIndex"] = true;
}

<div class="shell auth">
    <h1>@L["Account_ResetTitle"]</h1>

    <form method="post" asp-controller="Account" asp-action="ResetPassword" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="notice notice-bad"></div>
        <input type="hidden" asp-for="Code" />

        <div class="cinput">
            <label asp-for="Email">@L["Checkout_Email"]</label>
            <input asp-for="Email" type="email" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="cinput">
            <label asp-for="Password">@L["Account_NewPassword"]</label>
            <input asp-for="Password" autocomplete="new-password" />
            <small class="hint">@L["Account_PasswordRule"]</small>
            <span asp-validation-for="Password"></span>
        </div>

        <div class="cinput">
            <label asp-for="ConfirmPassword">@L["Account_ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn-shop auth-submit">@L["Account_SaveNewPassword"]</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
