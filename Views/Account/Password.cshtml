@model WebShop.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = L["Account_Password"].Value;
    ViewData["NoIndex"] = true;
    ViewData["AccountSection"] = "Password";
}

<div class="shell acct">
    <partial name="_AccountNav" />

    <div class="acct-main">
        <h1>@L["Account_Password"]</h1>

        @if (TempData["Saved"] is true)
        {
            <div class="notice notice-good"><p>@L["Account_PasswordChanged"]</p></div>
        }

        <form method="post" asp-controller="Account" asp-action="Password" class="acct-form">
            <div asp-validation-summary="ModelOnly" class="notice notice-bad"></div>

            <div class="cinput">
                <label asp-for="CurrentPassword">@L["Account_CurrentPassword"]</label>
                <input asp-for="CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>

            <div class="cinput">
                <label asp-for="NewPassword">@L["Account_NewPassword"]</label>
                <input asp-for="NewPassword" autocomplete="new-password" />
                <small class="hint">@L["Account_PasswordRule"]</small>
                <span asp-validation-for="NewPassword"></span>
            </div>

            <div class="cinput">
                <label asp-for="ConfirmNewPassword">@L["Account_ConfirmPassword"]</label>
                <input asp-for="ConfirmNewPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword"></span>
            </div>

            <button type="submit" class="btn-shop">@L["Account_SaveNewPassword"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
