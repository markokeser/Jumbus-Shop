@model List<WebShop.Models.Orders.Order>
@{
    ViewData["Title"] = L["Nav_MyOrders"].Value;
    ViewData["NoIndex"] = true;
    ViewData["AccountSection"] = "Orders";
}

<div class="shell acct">
    <partial name="_AccountNav" />

    <div class="acct-main">
        <h1>@L["Nav_MyOrders"]</h1>

        @if (Model.Count == 0)
        {
            <div class="empty">
                <h2>@L["Orders_None"]</h2>
                <a class="btn-shop" asp-controller="Products" asp-action="Index">@L["Footer_AllProducts"]</a>
            </div>
        }
        else
        {
            <partial name="_OrderList" model="Model" />
        }
    </div>
</div>
